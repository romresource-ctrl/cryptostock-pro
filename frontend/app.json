{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "package": "com.cryptostockapps.aicryptostockpro",
      "permissions": [
        "com.android.vending.BILLING",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "com.cryptostockapps.aicryptostockpro",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record voice notes in the chatroom."
      }
    },
    "name": "AI Crypstock Pro",
    "newArchEnabled": true,
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos in the premium chatroom.",
          "cameraPermission": "Take a photo to share in the chatroom."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# --- react-native-iap / Play Billing ---\n-keep class com.android.vending.billing.**\n-keep class com.android.billingclient.api.** { *; }\n-dontwarn com.android.billingclient.api.**\n-keep class com.dooboolab.rniap.** { *; }\n-dontwarn com.dooboolab.rniap.**\n# --- react-native-nitro-modules ---\n-keep class com.margelo.nitro.** { *; }\n-dontwarn com.margelo.nitro.**\n"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice notes in the chatroom."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F0B90B"
        }
      ],
      "expo-asset",
      "./plugins/withRemoveMediaPlaybackPermission",
      "expo-localization"
    ],
    "scheme": "aicryptostockpro",
    "slug": "ai-crypto-stock-pro",
    "userInterfaceStyle": "automatic",
    "version": "8.5.0",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "output": "single"
    }
  }
}
