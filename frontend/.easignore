# .easignore — used by EAS CLI to decide which files to include in the
# build tarball WHEN NO GIT REPO IS PRESENT (the typical case for
# Emergent's containerized build service, where the frontend folder is
# unpacked without a nested `.git`).
#
# Syntax is identical to `.gitignore`. If this file exists, EAS uses it
# INSTEAD of `git ls-files`, which sidesteps the
# "fatal: not a git repository (exit 128)" error we hit during
# `git rev-parse --show-toplevel`.
#
# Rule of thumb: mirror `.gitignore` PLUS also strip build/test caches
# and prebuild native folders so the tarball is small and reproducible.

# ---------- Node ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Expo / Metro ----------
.expo/
.expo-shared/
dist/
web-build/
.metro-cache/
.metro-health-check*
expo-env.d.ts

# ---------- Native (regenerated by `expo prebuild` during build) ----------
android/
ios/
.kotlin/

# ---------- Secrets & signing artifacts ----------
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.env*.local

# ---------- OS junk ----------
.DS_Store
Thumbs.db

# ---------- TS/JS build outputs ----------
*.tsbuildinfo

# ---------- Python / backend leftovers (not part of frontend build) ----------
__pycache__/
*.pyc
.pytest_cache/

# ---------- Example scaffold folder from the Expo template ----------
app-example/
